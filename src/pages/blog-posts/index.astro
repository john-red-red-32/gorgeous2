---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { articles } from '../../data/content';
const logo = 'https://8eb147f7d859a9618e57d27ae5aa5933.cdn.bubble.io/f1764895866717x944082419627878600/Untitled%20design%20%281%29.png';
---
<SiteLayout title="Aesthetics Knowledge Hub & Blog | The Gorgeous Clinic Blackpool" description="Explore The Gorgeous Clinic knowledge hub for helpful articles about lip fillers, anti-wrinkle injections, aesthetic treatments, safety and aftercare.">
  <div class="original-page-top" aria-hidden="true"></div>
  <div class="original-page-medallion"><img src={logo} alt="" /></div>
  <section class="original-knowledge-title">
    <h1>Knowledge Hub</h1>
    <p>Honest, medically-led advice on aesthetics treatments; from what to expect, to how to choose the right clinic.</p>
  </section>
  <section class="original-knowledge-articles container">
    <h2>A-Z List of blog posts</h2>
    <p class="original-panel-note">Initial layout preview. All original article text, images, authors, references and dates will be migrated from Bubble.</p>
    <div class="original-knowledge-grid">
      {articles.map(a=><a class="original-knowledge-card" href={'/blog/'+a.slug+'/'}><span class="eyebrow">{a.category}</span><h3>{a.title}</h3><p>{a.description}</p><span class="original-knowledge-link">Read article →</span></a>)}
    </div>
  </section>
</SiteLayout>
