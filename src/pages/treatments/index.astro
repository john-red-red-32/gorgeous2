---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {treatments, bookingUrl} from '../../data/content';
import {concerns, treatmentRelationships, catalogueStatus} from '../../data/catalogue';
const assetBase='https://8eb147f7d859a9618e57d27ae5aa5933.cdn.bubble.io';
const clinicMark=assetBase+'/f1764895866717x944082419627878600/Untitled%20design%20%281%29.png';
const categories=[...new Set(treatments.map(t=>t.category))];
const discoveryData = {
  concerns: concerns.map(c=>({slug:c.slug,name:c.name,description:c.description,explainer:c.explainer,treatmentSlugs:c.treatmentSlugs})),
  treatments: treatments.map(t=>({slug:t.slug,name:t.name,category:t.category,summary:t.summary})),
  prices: treatmentRelationships.map(r=>({slug:r.treatmentSlug,lines:r.priceLines}))
};
const paths = [
 {id:'concerns', anchor:'explore-concerns', icon:'✦', name:'Explore by Concern', subtitle:'I know what bothers me, but not what treatment I need.'},
 {id:'list',anchor:'treatment-list',icon:'≡',name:'Browse Treatments',subtitle:'I already have a treatment in mind.'},
 {id:'consult',anchor:'virtual-consultation',icon:'✧',name:'Virtual Consultation',subtitle:'I’d like some guidance before I decide.'},
 {id:'prices',anchor:'price-list',icon:'£',name:'View Price List',subtitle:'I just want to compare the treatments and prices.'}
];
---
<SiteLayout title="Explore Medical Aesthetics Treatments in Blackpool | The Gorgeous Clinic" description="Explore aesthetics treatments by concern, browse all treatments, get guided advice or view prices. Find answers and treatment education at The Gorgeous Clinic.">
  <div class="original-page-top" aria-hidden="true"></div>
  <div class="original-page-medallion"><img src={clinicMark} alt="" /></div>
  <section class="original-treatment-title">
    <h1>Treatments</h1>
    <p>Not sure where to begin? Discover our treatments in whichever way suits you.</p>
  </section>
  <section class="tgc-discovery-shell" aria-label="Explore treatments">
    <div class="tgc-pathways" role="group" aria-label="Choose how to explore">
      {paths.map((p,i)=>
        <button class:list={['tgc-pathway',{ 'is-selected':i===0 }]} type="button" data-tgc-tab={p.id} data-anchor={p.anchor} aria-controls={'tgc-panel-'+p.id} aria-expanded={i===0?'true':'false'}>
          <span class="tgc-pathway-icon" aria-hidden="true">{p.icon}</span>
          <strong>{p.name}</strong>
          <small>{p.subtitle}</small>
          <span class="tgc-pathway-arrow" aria-hidden="true">↗</span>
        </button>
      )}
    </div>
    <script type="application/json" id="tgc-discovery-data" set:html={JSON.stringify(discoveryData).replace(/</g,'\\u003c')} />
    <div class="tgc-discovery-view">
      <section id="tgc-panel-concerns" class="tgc-discovery-panel" aria-label="Explore by concern">
        <div class="tgc-panel-intro"><div><p class="eyebrow">Explore by concern</p><h2>What's on your mind?</h2><p>Select one or more concerns. We'll explain what may be relevant, using the treatment relationships in our catalogue.</p></div></div>
        <div class="original-concern-grid tgc-modern-concerns">
          {concerns.map(c=><div class="original-concern-card tgc-accessible-concern">
            <label class="tgc-concern-select" for={'tgc-concern-'+c.slug}>
              <input id={'tgc-concern-'+c.slug} type="checkbox" name="concern" value={c.slug} />
              <span class="original-concern-copy"><strong>{c.name}</strong><small>{c.description}</small></span>
              {c.image && <img src={c.image} alt="" loading="lazy" />}
            </label>
            <a class="tgc-inline-concern" href={'/concerns/'+c.slug+'/'}>Learn about this concern ↗</a>
          </div>)}
        </div>
        <div class="tgc-selector-actions"><button class="heritage-solid-button" id="view-tgc-selections" type="button">View Related Treatments <span aria-hidden="true">→</span></button><span id="tgc-concern-count" aria-live="polite">Select the concerns you'd like to explore</span></div>
        <div id="selected-concerns-result" class="tgc-results" hidden aria-live="polite" tabindex="-1"></div>
      </section>
      <section id="tgc-panel-list" class="tgc-discovery-panel" hidden aria-label="Browse all treatments">
        <div class="tgc-panel-intro"><div><p class="eyebrow">Browse treatments</p><h2>Discover the treatments.</h2><p>If you know the treatment you're looking for, browse by name or category. Selecting a treatment opens its details in the side panel.</p></div></div>
        <label class="tgc-search-label" for="tgc-treatment-search">Search the treatment list</label>
        <input id="tgc-treatment-search" class="tgc-search-field" type="search" placeholder="Search treatments…" autocomplete="off" />
        <div class="original-treatment-list tgc-treatment-index">
          {categories.map(category=><div class="original-treatment-category" data-tgc-category><h3>{category}</h3>{treatments.filter(t=>t.category===category).map(t=><a href={'/treatments/'+t.slug+'/'} data-tgc-treatment-name={t.name.toLowerCase()}>{t.name}<span aria-hidden="true">↗</span></a>)}</div>)}
        </div>
        <p id="tgc-search-empty" hidden>No matching treatments. Try a different search.</p>
        <p class="original-panel-note">{catalogueStatus}</p>
      </section>
      <section id="tgc-panel-consult" class="tgc-discovery-panel" hidden aria-label="Guided virtual consultation">
        <div class="tgc-panel-intro"><div><p class="eyebrow">A little guidance goes a long way</p><h2>Your virtual consultation.</h2><p>Tell us what's bothering you. This first version is a guided educational preview; the conversational AI will be added once our full treatment knowledge is imported.</p></div></div>
        <div class="tgc-consult-chat" id="tgc-consult-chat" aria-live="polite">
          <div class="tgc-chat-message is-assistant"><span class="tgc-chat-from">THE GORGEOUS CLINIC</span><p>Hello! What would you like to learn more about? You can describe a concern in your own words or select one of the topics below.</p></div>
        </div>
        <div class="tgc-consult-picks" aria-label="Suggested concerns">
          {concerns.slice(0,8).map(c=><button type="button" data-consult-concern={c.slug}>{c.name}</button>)}
        </div>
        <form id="tgc-consult-form" class="tgc-consult-form">
          <label for="tgc-consult-text">Describe your concern</label>
          <div class="tgc-consult-compose"><textarea id="tgc-consult-text" rows="3" maxlength="700" placeholder="For example: I have fine lines around my eyes and I'm not sure where to start." required></textarea><button type="submit" class="heritage-solid-button">Explore <span aria-hidden="true">→</span></button></div>
          <p>Your text stays in this browser in the current prototype. This is general educational guidance, not an individual assessment.</p>
        </form>
      </section>
      <section id="tgc-panel-prices" class="tgc-discovery-panel" hidden aria-label="Treatment price list">
        <div class="tgc-panel-intro"><div><p class="eyebrow">Clear and straightforward</p><h2>Our price list.</h2><p>Browse treatments and their prices together. Exact amounts will be added directly from the Bubble export, so pricing stays consistent across the website.</p></div></div>
        <div class="tgc-price-table"><div class="tgc-price-header"><strong>Treatment</strong><strong>Price</strong></div>
          {treatments.map(t=>{const prices=treatmentRelationships.find(r=>r.treatmentSlug===t.slug)?.priceLines||[];return <div class="tgc-price-row"><a href={'/treatments/'+t.slug+'/'}>{t.name} <span aria-hidden="true">↗</span></a><span>{prices.length>0 ? prices.map(p=>'£'+p.gbp.toFixed(2)).join(' / ') : 'See live price list'}</span></div>})}
        </div>
        <p class="original-panel-note">The verified clinic price data has not yet been imported. No estimated prices are shown.</p>
        <a class="heritage-ghost-button" href="https://thegorgeousclinic.co.uk/treatments/" target="_blank" rel="noopener noreferrer">View Current Prices ↗</a>
      </section>
    </div>
  </section>
  <section class="heritage-feature-band"><h2>Knowledge is power.</h2><p>Explore the different approaches to aesthetics, compare treatment options and book a free consultation whenever you're ready.</p><a class="heritage-ghost-button" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a Free Consultation →</a></section>
  <script is:inline src="/discovery.js" defer></script>
</SiteLayout>
