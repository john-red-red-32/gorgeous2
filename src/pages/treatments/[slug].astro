---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { treatments, bookingUrl } from '../../data/content';
import { articlesForTreatment, concernsForTreatment, treatmentRelationships } from '../../data/catalogue';

export function getStaticPaths() {
  return treatments.map(treatment => ({params: {slug: treatment.slug}, props: {treatment}}));
}
const {treatment} = Astro.props;
const articles = articlesForTreatment(treatment.slug);
const concerns = concernsForTreatment(treatment.slug);
const relation = treatmentRelationships.find(r => r.treatmentSlug === treatment.slug);
const priceLines = relation?.priceLines || [];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: treatment.name + ' | The Gorgeous Clinic',
  url: 'https://thegorgeousclinic.co.uk/treatments/' + treatment.slug + '/',
  description: treatment.summary
};
---
<SiteLayout title={treatment.name + ' in Blackpool | The Gorgeous Clinic'} description={treatment.summary + ' Find out more at The Gorgeous Clinic, Blackpool.'} schema={schema}>
  <article data-treatment-detail class="treatment-detail">
    <section class="treatment-detail-hero">
      <p class="eyebrow">{treatment.category} · The Gorgeous Clinic</p>
      <h1>{treatment.name}</h1>
      <p class="treatment-detail-summary">{treatment.summary}</p>
      <div class="treatment-detail-actions">
        <a class="heritage-solid-button" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book a Free Consultation ↗</a>
        <a class="heritage-ghost-button" href="/treatments/">All Treatments</a>
      </div>
    </section>
    <div class="treatment-detail-content">
      <p class="treatment-detail-kicker">Understanding the treatment</p>
      <h2>A thoughtful approach to {treatment.name.toLowerCase()}</h2>
      {treatment.sections && treatment.sections.length>0
        ? <div class="tgc-original-treatment-sections">
            {treatment.sections.map(section=>
              <section class="treatment-detail-section tgc-original-treatment-section" aria-label={section.title || treatment.name}>
                {section.title && <h2>{section.title}</h2>}
                {section.imageUrl && <img class="tgc-original-section-photo" src={section.imageUrl} alt={section.title || treatment.name} loading="lazy" />}
                {section.body && <p class="tgc-preserve-paragraphs">{section.body}</p>}
                {section.type === 'Video' && <p class="tgc-original-video-caption">From the clinic video collection. The original Vimeo video reference will be added during media migration.</p>}
              </section>
            )}
          </div>
        : treatment.introduction
          ? <p>{treatment.introduction}</p>
          : <p>Details from the clinic's treatment catalogue are being transferred. Please contact our team for more information.</p>
      }
      <p>Every treatment starts with understanding your goals. We'll explain your options and help you decide what feels right for you.</p>
      {treatment.anaesthetic && <p class="tgc-treatment-meta"><strong>Anaesthetic:</strong> {treatment.anaesthetic}</p>}
      {treatment.bookingUrl && <p><a class="tgc-understated-link" href={treatment.bookingUrl} target="_blank" rel="noopener noreferrer">View this treatment in our booking system ↗</a></p>}
      {treatment.benefits.length > 0 && <section class="treatment-detail-section"><h2>What we can discuss</h2><ul class="treatment-detail-benefits">{treatment.benefits.map(item=><li>{item}</li>)}</ul></section>}
      {concerns.length > 0 && <section class="treatment-detail-section"><h2>Related concerns</h2><p>Learn how these concerns differ and which approaches may be worth exploring.</p><div class="treatment-detail-tags">{concerns.map(c=><a href={'/concerns/'+c.slug+'/'}>{c.name} <span aria-hidden="true">↗</span></a>)}</div></section>}
      {priceLines.length > 0 && <section class="treatment-detail-section"><h2>Prices</h2>{priceLines.map(p=><p class="treatment-price-row"><span>{p.name}</span><strong>£{p.gbp.toFixed(2)}</strong></p>)}</section>}
      {articles.length > 0 && <section class="treatment-detail-section"><h2>From our Knowledge Hub</h2><div class="treatment-detail-related">{articles.map(a=><a href={'/blog/'+a.slug+'/'}><span>{a.category}</span><strong>{a.title}</strong><small>Read article ↗</small></a>)}</div></section>}
      {relation && relation.gallerySlugs.length > 0 && <section class="treatment-detail-section"><h2>Related results</h2><div class="treatment-detail-tags">{relation.gallerySlugs.map(slug=><a href={'/gallery/'+slug+'/'}>View result ↗</a>)}</div></section>}
      {relation && relation.videoIds.length > 0 && <section class="treatment-detail-section"><h2>Videos</h2><div class="treatment-detail-videos">{relation.videoIds.map(id=><div class="treatment-video"><iframe title={treatment.name+' treatment video'} src={'https://player.vimeo.com/video/'+encodeURIComponent(id)} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe></div>)}</div></section>}
      {treatment.faqs && treatment.faqs.length>0 && <section class="treatment-detail-section tgc-treatment-faqs">
        <h2>Frequently asked questions</h2>
        {treatment.faqs.map(item=><details><summary>{item.question}</summary><p class="tgc-preserve-paragraphs">{item.answer}</p></details>)}
      </section>}
      {treatment.childOf && <section class="treatment-detail-section">
        <p class="eyebrow">Part of a treatment family</p><h2>{treatment.childOf}</h2>
        <p>This treatment is listed within the {treatment.childOf} collection in the clinic's original treatment catalogue.</p>
      </section>}
      <div class="treatment-detail-bottom"><h2>Let's talk about your goals.</h2><p>Book a free consultation and explore your options with our team.</p><a class="heritage-solid-button" href={bookingUrl} target="_blank" rel="noopener noreferrer">Free Consultation ↗</a></div>
      <p class="original-panel-note">Development preview: original treatment sections and FAQ answers have been imported where their parent relationships could be matched. Prices, remaining images, videos and missing content are still being migrated.</p>
    </div>
  </article>
</SiteLayout>
